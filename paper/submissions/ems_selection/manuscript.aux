\def\@LN@column{1}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Choices on the focal event and their outcome on later burning, for the thermal RF against four location-using candidates. Chosen: number of fires in which the pooled AUC, the cAUC and the stratified cAUC chose the candidate. Better: fires in which the thermal RF had the higher AUC on later burning. Difference: mean AUC on later burning, thermal RF minus candidate, with 95\% bootstrap interval over fires. Loss: mean AUC loss of the pooled AUC's choice. Rule: transfer-failure rule of Section~\ref {sec:loss}. Window A has 18{} fires and window B 18, 13{} of them in both.}}{10}{table.1}\protected@file@percent }
\newlabel{tab:select}{{1}{10}{Choices on the focal event and their outcome on later burning, for the thermal RF against four location-using candidates. Chosen: number of fires in which the pooled AUC, the cAUC and the stratified cAUC chose the candidate. Better: fires in which the thermal RF had the higher AUC on later burning. Difference: mean AUC on later burning, thermal RF minus candidate, with 95\% bootstrap interval over fires. Loss: mean AUC loss of the pooled AUC's choice. Rule: transfer-failure rule of Section~\ref {sec:loss}. Window A has \sAElig {} fires and window B \sBElig , \sBOverlap {} of them in both}{table.1}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Focal-event choice against outcome on later burning, one marker per fire and window. The horizontal axis is the pooled AUC of the thermal RF minus that of the coordinate-only RF under 5~km block cross-validation on the focal fire, so every marker left of the vertical line is a fire in which the pooled AUC chose the coordinate-only RF. The vertical axis is the same difference in AUC on later burning in the same study rectangle, so markers above the horizontal line are fires in which that choice was the worse one. Filled circles: later burning to the end of 2023. Hollow squares: later burning from January 2024 to September 2026, scored with frozen focal predictions. Where two markers would overlap, one is shifted slightly and joined to its true position by a short line.}}{11}{figure.1}\protected@file@percent }
\newlabel{fig:fires}{{1}{11}{Focal-event choice against outcome on later burning, one marker per fire and window. The horizontal axis is the pooled AUC of the thermal RF minus that of the coordinate-only RF under 5~km block cross-validation on the focal fire, so every marker left of the vertical line is a fire in which the pooled AUC chose the coordinate-only RF. The vertical axis is the same difference in AUC on later burning in the same study rectangle, so markers above the horizontal line are fires in which that choice was the worse one. Filled circles: later burning to the end of 2023. Hollow squares: later burning from January 2024 to September 2026, scored with frozen focal predictions. Where two markers would overlap, one is shifted slightly and joined to its true position by a short line}{figure.1}{}}
