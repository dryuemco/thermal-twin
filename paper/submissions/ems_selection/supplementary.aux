\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces Registered analyses in amendments 9, 10, 11 and 15. Choices, loss ($L$) and relative loss use the order pooled AUC, cAUC, stratified cAUC. Choices count fires selecting the location candidate. $\Delta $ is thermal minus candidate later AUC, with 95\% intervals where shown. Results use the label variant of this build.}}{5}{table.4}\protected@file@percent }
\newlabel{tab:s-plan}{{S4}{5}{Registered analyses in amendments 9, 10, 11 and 15. Choices, loss ($L$) and relative loss use the order pooled AUC, cAUC, stratified cAUC. Choices count fires selecting the location candidate. $\Delta $ is thermal minus candidate later AUC, with 95\% intervals where shown. Results use the label variant of this build}{table.4}{}}
