      ],
      "collection": "ECMWF/ERA5_LAND/HOURLY",
      "raster_export_performed": false
    },
    "spatial_aggregation": {
      "masks_respected": true,
      "method": "explicit_pixel_area_weighted_regional_mean_v1",
      "projection": "ERA5-Land native crs + crsTransform, probed per run",
      "semantics": "sum(value * ee.Image.pixelArea()) / sum(ee.Image.pixelArea() masked by that variable's own mask), reduced with ee.Reducer.sum() on the ERA5-Land native projection (crs + crsTransform, probed once per run). A bare ee.Reducer.mean() is NOT area weighting and is not used"
    },
    "temporal_aggregation": {
      "expected_hours_formula": "n_days_inclusive * 24",
      "hourly_completeness_rule": "every window must contain the EXACT contiguous UTC hourly sequence [start 00:00, end_exclusive 00:00), in order, with expected_hours = n_days_inclusive * 24; missing, duplicate, out-of-order, shifted and extra hours fail closed and are never sorted, deduplicated, interpolated, padded or dropped",
      "incomplete_window_policy": "fail_closed",
      "max_meaning": "maximum regional-hour condition, not a per-pixel extreme",
      "method": "statistics_over_hourly_area_weighted_regional_means_v1",
      "semantics": "window statistics are computed over the SERIES OF HOURLY AREA-WEIGHTED AOI MEANS: mean = arithmetic mean of those hourly regional means, max = maximum regional-hour condition (never the most extreme individual pixel), total (precipitation only) = sum of the hourly regional means",
      "statistics": {
        "precipitation_mm": [
          "mean",
          "max",
          "total"
        ],
        "relative_humidity_percent": [
          "mean",
          "max"
        ],
        "temperature_c": [
          "mean",
          "max"
        ],
        "wind_speed_m_s": [
          "mean",
          "max"
        ]
      },
      "timestamp_convention": "Unix epoch milliseconds, UTC, matching Earth Engine system:time_start"
    },
