  "scientific_config": {
    "climatology": {
      "anomaly": "observed - climatology_mean",
      "mean": "arithmetic mean of the four yearly window statistics",
      "per_year_statistics_computed_independently": true,
      "reference_years": [
        2017,
        2018,
        2019,
        2020
      ],
      "sd_convention": "sample standard deviation, ddof=1",
      "sd_ddof": 1,
      "standardized_anomaly": "anomaly / climatology_sd",
      "window_mapping": "the observed window's exact month/day start and end are mapped into each reference year; a month/day that cannot be represented fails closed",
      "zero_sd_policy": "standardized_anomaly is null and zero_climatology_sd is true; never inf and never substituted with 0"
    },
    "derived_variables": {
      "precipitation_mm": {
        "cumulative_band_used": false,
        "m_to_mm": 1000.0,
        "recipe": "precipitation_mm = total_precipitation_hourly * 1000 (m -> mm of depth accumulated in that hour); the cumulative total_precipitation band is NEVER used",
        "source_bands": [
          "total_precipitation_hourly"
        ],
        "units": "mm"
      },
      "relative_humidity_percent": {
        "clipped": false,
        "constants": {
          "T0_K": 273.16,
          "a1_Pa": 611.21,
          "a3": 17.502,
          "a4_K": 32.19
        },
        "derivation_level": "per_pixel_per_hour",
        "recipe": "RH = 100 * es(Td) / es(T) with es(T) = a1 * exp(a3 * (T - T0) / (T - a4)); ECMWF/Tetens saturation over water; derived per pixel per hour from temperature_2m and dewpoint_temperature_2m; NOT clipped to [0, 100]",
        "saturation_phase": "water",
        "source_bands": [
          "temperature_2m",
          "dewpoint_temperature_2m"
        ],
        "units": "percent"
      },
      "temperature_c": {
        "kelvin_offset": 273.15,
        "recipe": "temperature_c = temperature_2m - 273.15",
        "source_bands": [
          "temperature_2m"
        ],
        "units": "degC"
      },
      "wind_speed_m_s": {
        "derivation_level": "per_pixel_per_hour",
        "recipe": "wind_speed_m_s = sqrt(u_component_of_wind_10m^2 + v_component_of_wind_10m^2); derived per pixel per hour",
        "source_bands": [
          "u_component_of_wind_10m",
          "v_component_of_wind_10m"
        ],
        "units": "m s-1"
      }
    },
    "diagnostic_class": "explanatory_aoi_level_regional_meteorology",
    "diagnostic_namespace": "era5_land_regional",
