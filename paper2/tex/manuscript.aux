\def\@LN@column{1}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces The analysis cell's true ground dimensions, per region. Columns and rows are derived by dividing each AOI's span by the cell step of 0.0045814\textdegree {} and rounding outward; the frozen cell count is the one recorded in the pipeline's own outputs, and the two agree exactly in every region. The north-south edge is about 510 m everywhere; only the east-west edge varies, with latitude.}}{11}{}\protected@file@percent }
\newlabel{tab:1}{{1}{11}{}{table.1}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Observation provenance: a quality rule applied to part of a cohort}{12}{}\protected@file@percent }
\newlabel{sec:4.2}{{4.2}{12}{}{subsection.4.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Cost of the quality-screening rule in the three regions that were exported without it. Each region's predictor-window mean was recomputed with the \texttt  {QC\_\allowbreak  {}Day} bit rule and the three-observation minimum applied, and differenced against the frozen unscreened mean. The final column is what matters: a shift correlated with elevation is not an offset a downscaling model would absorb.}}{12}{}\protected@file@percent }
\newlabel{tab:2}{{2}{12}{}{table.2}{}}
\def\@LN@column{1}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Compositing: a decision whose relevance is readable in advance}{14}{}\protected@file@percent }
\newlabel{sec:4.3}{{4.3}{14}{}{subsection.4.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Whether the compositing choice can act, read from the scene inventory alone. Scenes per distinct acquisition date is counted before anything is fitted. Where it is 1.0 the two compositing chains produce identical rasters and there are no same-day boundaries to compare, so the verdict is not "no evidence" but "no effect is possible". The verdict column reports the boundary-discontinuity audit only for the three regions where the intervention can act.}}{15}{}\protected@file@percent }
\newlabel{tab:3}{{3}{15}{}{table.3}{}}
