# === Emrehan'in ayri deposu ===
# 2026-08-11: artik ignore DEGIL. `repo/` bir git submodule olarak bagli
# (github.com/emrehann17/satellite-thermal-digital-twin), 48b56e7'e sabitli.
# Makale Methods'u bu commit'teki satir numaralarina atif veriyor, bu yuzden
# pinlenmis olmasi provenance'in parcasi. Icerigi hala SALT OKUNUR.

# === Sanal ortam ===
.venv-step10/

# === Agir / bizim uretmedigimiz mevcut ciktilar ===
outputs/
data/
# The label-corrected Manavgat table is primary data and must travel with the code (2026-09-19).
!paper/data/
!paper/data/**

# Agir step ciktilari (Step10 disi)
experiments/*/step0/
experiments/*/step5*/
experiments/*/step7*/
experiments/*/step8a/
experiments/*/step8b/
experiments/*/step8c/
experiments/*/step8d/
experiments/*/gate_inputs/
experiments/*/validation/

# Emrehan'in kok-seviye yardimci dosyalari (bizim isimiz degil)
experiments/*/predictor_export_metadata.json

# step8e: SADECE JSON raporunu tut (provenance); .md ve digerleri disari
experiments/*/step8e/*
!experiments/*/step8e/final_step8_report.json

# =====================================================================
# MUAFIYETLER: bizim Step10 urunlerimiz dahil (whitelist)
# =====================================================================
!step10/
!step10/**

# Step10 metin ciktilari (cross_region)
!experiments/cross_region/
!experiments/cross_region/step10/
!experiments/cross_region/step10/**

# Step10 within-robustness JSON'lari (bolge bazli)
!experiments/*/step10/
!experiments/*/step10/**

# =====================================================================
# SON SOZ (whitelist'i ezer): agir ikililer + build/OS artiklari HER YERDE
# ignore. Bu, step10 dizinlerindeki predictions.parquet ve __pycache__/*.pyc
# gibi dosyalarin da ASLA staged olmamasini garanti eder.
# =====================================================================
*.parquet
*.tif
*.tiff
*.joblib
*.zip
.DS_Store
__pycache__/
*.pyc

drive_archive

drive_new

# Per-cell prediction dumps from step9b: same policy as *.parquet above --
# heavy row-level output, not cited anywhere. The file is still hashed in the
# raw directory's SHA256SUMS.txt so its provenance is recorded.
cross_region_transfer_predictions.csv

# LaTeX build products (the PDF is a deliverable, the rest is noise)
paper/tex/*.aux
paper/tex/*.log
paper/tex/*.out
paper/tex/*.blg
paper/tex/*.spl

# Primary label-corrected data (2026-09-19); overrides the *.parquet / *.tif rules above.
!paper/data/**/*.parquet
!paper/data/**/*.tif
